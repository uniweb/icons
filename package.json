{
  "name": "@uniweb/icons",
  "version": "0.4.13",
  "description": "Icon library for Uniweb - lazily loaded SVG icons from popular icon sets",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./resolver": "./src/resolver.js",
    "./families/*": "./src/families/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "convert": "node scripts/convert.js",
    "convert:all": "node scripts/convert.js --all"
  },
  "dependencies": {
    "@uniweb/core": "workspace:^"
  },
  "devDependencies": {
    "react-icons": "5.7.0"
  },
  "keywords": [
    "uniweb",
    "icons",
    "svg",
    "lucide",
    "heroicons",
    "phosphor",
    "tabler",
    "feather"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uniweb/icons.git"
  }
}
